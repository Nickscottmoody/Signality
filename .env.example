# Copy this file to ".env" and fill in your real values.
# .env is listed in .gitignore, so it never gets uploaded to GitHub.

# From @BotFather on Telegram (Stage 1)
TELEGRAM_BOT_TOKEN=

# From @userinfobot on Telegram (Stage 1) — only this ID can use bot commands
TELEGRAM_USER_ID=

# From console.anthropic.com (needed in Stage 2a, not before)
ANTHROPIC_API_KEY=

# From app.tavily.com (Stage 3) — web search for corroboration. Free plan, no card.
TAVILY_API_KEY=
